#pragma once
#include <stddef.h>

#include <ktl/maybe>
#include <ktl/utility>

namespace ktl {

template <typename T, size_t N> class static_vector {
   public:
    bool push_back(T value) {
        if (m_count == N) { return false; }
        m_buffer[m_count++] = ktl::move(value);
        return true;
    }

    bool emplace_back(T&& value) {
        if (m_count == N) { return false; }
        m_buffer[m_count++] = ktl::move(value);
        return true;
    }

    maybe<T> pop_back() {
        if (m_count == 0) { return ktl::nothing; }
        return ktl::move(m_buffer[--m_count]);
    }

    void clear() { m_count = 0; }
    size_t size() const { return m_count; }
    size_t capacity() const { return N; }

    // iterator
    T* begin() { return m_buffer; }
    T* end() { return m_buffer + m_count; }

    // const iterator
    const T* begin() const { return m_buffer; }
    const T* end() const { return m_buffer + m_count; }

   private:
    T m_buffer[N];
    size_t m_count = 0;
};

}  // namespace ktl
