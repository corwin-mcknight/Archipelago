#pragma once
#include <stddef.h>

#include <ktl/maybe>
#include <ktl/utility>

namespace ktl {

template <typename T, size_t N> class static_vector {
   public:
    void push_back(T value) {
        if (m_count == N) { return; }
        m_buffer[m_count++] = ktl::move(value);
    }

    void emplace_back(T&& value) {
        if (m_count == N) { return; }
        m_buffer[m_count++] = ktl::move(value);
    }

    maybe<T> pop_back() { return m_count > 0 ? m_buffer[--m_count] : ktl::nothing; }
    maybe<T> peek_back() { return m_count > 0 ? m_buffer[m_count - 1] : ktl::nothing; }

    void clear() { m_count = 0; }
    size_t size() const { return m_count; }
    size_t capacity() const { return N; }

    maybe<T> at(size_t index) {
        if (index < m_count) { return m_buffer[index]; }
        return ktl::nothing;
    }
    T operator[](size_t index) { return at(index).value_or(T()); }

    // iterator
    T* begin() { return m_buffer; }
    T* end() { return m_buffer + m_count; }

    // const iterator
    const T* begin() const { return m_buffer; }
    const T* end() const { return m_buffer + m_count; }

   private:
    T m_buffer[N];
    size_t m_count = 0;
};

}  // namespace ktl
