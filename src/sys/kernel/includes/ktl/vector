#pragma once

#include <stddef.h>
#include <stdint.h>

#include <std/new.h>

#include <ktl/maybe>
#include <ktl/type_traits>
#include <ktl/utility>

namespace ktl {

template <typename T> class vector {
   public:
    using iterator       = T*;
    using const_iterator = const T*;

    vector()             = default;

    ~vector() { destroy_and_free(); }

    vector(const vector&)            = delete;
    vector& operator=(const vector&) = delete;

    vector(vector&& other) noexcept { move_from(ktl::move(other)); }

    vector& operator=(vector&& other) noexcept {
        if (this != &other) {
            destroy_and_free();
            move_from(ktl::move(other));
        }
        return *this;
    }

    bool push_back(T value) {
        if (!ensure_capacity(m_size + 1)) { return false; }
        new (&m_data[m_size++]) T(ktl::move(value));
        return true;
    }

    bool emplace_back(T&& value) { return push_back(ktl::move(value)); }

    ktl::maybe<T> pop_back() {
        if (empty()) { return ktl::nothing; }
        T value = ktl::move(m_data[m_size - 1]);
        m_data[--m_size].~T();
        return value;
    }

    // O(1) unordered removal: the last element replaces the removed one. Never self-moves,
    // so T's move-assignment need not handle self-assignment. Out-of-range indexes are ignored.
    void swap_remove(size_t index) {
        if (index >= m_size) { return; }
        --m_size;
        if (index != m_size) { m_data[index] = ktl::move(m_data[m_size]); }
        m_data[m_size].~T();
    }

    ktl::maybe<T> back() const {
        if (empty()) { return ktl::nothing; }
        return m_data[m_size - 1];
    }

    void clear() {
        for (size_t i = 0; i < m_size; ++i) { m_data[i].~T(); }
        m_size = 0;
    }

    size_t size() const { return m_size; }
    bool empty() const { return m_size == 0; }
    size_t capacity() const { return m_capacity; }

    bool reserve(size_t new_capacity) {
        if (new_capacity <= m_capacity) { return true; }
        return reallocate(new_capacity);
    }

    T& operator[](size_t index) { return m_data[index]; }
    const T& operator[](size_t index) const { return m_data[index]; }

    ktl::maybe<T> at(size_t index) const {
        if (index >= m_size) { return ktl::nothing; }
        return m_data[index];
    }

    T* data() { return m_data; }
    const T* data() const { return m_data; }

    iterator begin() { return m_data; }
    iterator end() { return m_data + m_size; }
    const_iterator begin() const { return m_data; }
    const_iterator end() const { return m_data + m_size; }

   private:
    static constexpr size_t k_initial_capacity = 4;

    void move_from(vector&& other) noexcept {
        m_data           = other.m_data;
        m_size           = other.m_size;
        m_capacity       = other.m_capacity;

        other.m_data     = nullptr;
        other.m_size     = 0;
        other.m_capacity = 0;
    }

    bool ensure_capacity(size_t required) {
        if (required <= m_capacity) { return true; }

        size_t new_capacity = m_capacity == 0 ? k_initial_capacity : m_capacity;
        while (new_capacity < required) {
            if (new_capacity > SIZE_MAX / 2) {
                new_capacity = required;
                break;
            }
            new_capacity *= 2;
        }
        return reallocate(new_capacity);
    }

    // Elements live in raw storage and are constructed/destroyed explicitly, so T need not be
    // default-constructible and growth move-constructs each element exactly once.
    bool reallocate(size_t new_capacity) {
        if (new_capacity > SIZE_MAX / sizeof(T)) { return false; }
        T* new_data = static_cast<T*>(operator new[](new_capacity * sizeof(T), std::nothrow));
        if (new_data == nullptr) { return false; }

        for (size_t i = 0; i < m_size; ++i) {
            new (&new_data[i]) T(ktl::move(m_data[i]));
            m_data[i].~T();
        }
        operator delete[](static_cast<void*>(m_data));

        m_data     = new_data;
        m_capacity = new_capacity;
        return true;
    }

    void destroy_and_free() {
        clear();
        operator delete[](static_cast<void*>(m_data));
    }

    T* m_data         = nullptr;
    size_t m_size     = 0;
    size_t m_capacity = 0;
};

}  // namespace ktl
