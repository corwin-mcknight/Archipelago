#pragma once

#include <stddef.h>
#include <string.h>

#include <ktl/utf8>

namespace ktl {
namespace format {

// General template for kfmt_printer. This will cause a compile-time error if used.
template <typename T> struct kfmt_printer {};

struct format_args {
    size_t width;
    char specifier;
    bool zero_padded;
    bool right_aligned;
    [[maybe_unused]] char padding[5];

    static void print_string(format_args args, char* buffer, size_t buffer_max, size_t& index, const char* value) {
        print_string(args, buffer, buffer_max, index, value, strlen(value));
    }

    static void print_string(format_args args, char* buffer, size_t buffer_max, size_t& index, const char* value,
                             size_t string_length) {
        // Width is a column count, so pad against codepoints, not bytes.
        const size_t display_length = utf8_codepoints(value, string_length);
        const size_t padding        = args.width > display_length ? args.width - display_length : 0;

        if (args.width && args.right_aligned) {
            for (size_t i = 0; (i < padding) && (index < (buffer_max - 1)); ++i) {
                buffer[index++] = args.zero_padded ? '0' : ' ';
            }
        }

        for (size_t i = 0; (i < string_length) && (index < (buffer_max - 1)); ++i) { buffer[index++] = value[i]; }

        if (args.width && !args.right_aligned) {
            for (size_t i = 0; (i < padding) && (index < (buffer_max - 1)); ++i) {
                buffer[index++] = args.zero_padded ? '0' : ' ';
            }
        }
    }
};

}  // namespace format
}  // namespace ktl