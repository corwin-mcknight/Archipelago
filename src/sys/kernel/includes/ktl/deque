#pragma once

#include <stddef.h>
#include <stdint.h>

#include <ktl/maybe>
#include <ktl/utility>
#include <ktl/vector>

namespace ktl {

template <typename T> class deque {
   private:
    static constexpr size_t k_block_capacity = 16;

    struct block {
        ktl::vector<T> values;
        size_t head = 0;

        size_t size() const { return values.size() - head; }
        bool empty() const { return size() == 0; }

        void reset() {
            values.clear();
            head = 0;
        }
    };

   public:
    constexpr deque() = default;
    deque(const deque&)            = delete;
    deque& operator=(const deque&) = delete;
    deque(deque&& other) noexcept : m_blocks(ktl::move(other.m_blocks)), m_size(other.m_size) { other.m_size = 0; }
    deque& operator=(deque&& other) noexcept {
        if (this != &other) {
            m_blocks     = ktl::move(other.m_blocks);
            m_size       = other.m_size;
            other.m_size = 0;
        }
        return *this;
    }

    bool push_back(T value) { return emplace_back_internal(ktl::move(value)); }
    bool emplace_back(T&& value) { return emplace_back_internal(ktl::move(value)); }

    ktl::maybe<T> pop_back() {
        if (empty()) { return ktl::nothing; }

        size_t back_block_index = last_non_empty_block_index();
        block& back_block       = m_blocks[back_block_index];

        ktl::maybe<T> value     = back_block.values.pop_back();
        if (value.has_value()) {
            if (back_block.empty()) { back_block.reset(); }
            --m_size;
        }
        return value;
    }

    ktl::maybe<T> pop_front() {
        if (empty()) { return ktl::nothing; }

        size_t front_index = first_non_empty_block_index();
        block& front_block = m_blocks[front_index];

        T result           = ktl::move(front_block.values[front_block.head]);
        ++front_block.head;
        if (front_block.empty()) { front_block.reset(); }

        --m_size;
        remove_empty_front_blocks();
        return result;
    }

    ktl::maybe<T> back() const {
        if (empty()) { return ktl::nothing; }
        size_t index            = last_non_empty_block_index();
        const block& back_block = m_blocks[index];
        return back_block.values[back_block.values.size() - 1];
    }

    void clear() {
        for (size_t i = 0; i < m_blocks.size(); ++i) { m_blocks[i].reset(); }
        m_blocks.clear();
        m_size = 0;
    }

    size_t size() const { return m_size; }
    bool empty() const { return m_size == 0; }

    // Kept for the tests that prove reserve()'s no-allocation promise: capacity unchanged
    // across a burst means no block was appended.
    size_t capacity() const {
        size_t total = 0;
        for (size_t i = 0; i < m_blocks.size(); ++i) { total += m_blocks[i].values.capacity(); }
        return total;
    }

    bool reserve(size_t new_capacity) {
        if (new_capacity > SIZE_MAX - (k_block_capacity - 1)) { new_capacity = SIZE_MAX - (k_block_capacity - 1); }
        // One block beyond the size-based need: room checks run against physical occupancy, and
        // the front block can hold up to k_block_capacity - 1 consumed (not yet compacted) slots,
        // so a push/pop cycle within the reserved size can still fill one extra block. Without it,
        // the first such push past a block boundary would allocate -- exactly what callers that
        // push from interrupt context called reserve() to prevent.
        size_t required_blocks = (new_capacity + k_block_capacity - 1) / k_block_capacity + 1;
        if (!m_blocks.reserve(required_blocks)) { return false; }

        while (m_blocks.size() < required_blocks) {
            if (!append_empty_block_back()) { return false; }
        }

        return true;
    }

   private:
    bool emplace_back_internal(T&& value) {
        size_t target;
        if (!select_back_block(target)) { return false; }
        block& back_block = m_blocks[target];
        if (!back_block.values.push_back(ktl::move(value))) { return false; }
        ++m_size;
        return true;
    }

    // Pick the block push_back fills: the last non-empty block while it has physical room, then
    // the already-provisioned empty block behind it, appending a fresh block only when neither
    // exists. Filling provisioned empties in order is what makes reserve()'s no-allocation
    // promise hold for bursts longer than one block -- targeting only the physically-last block
    // would leave every pre-created block unreachable in front of it, and the promise is what
    // lets the scheduler push from interrupt context. Non-empty blocks stay contiguous, so
    // indexing and the pop paths are unaffected.
    bool select_back_block(size_t& target) {
        if (m_blocks.empty()) {
            if (!append_empty_block_back()) { return false; }
            target = 0;
            return true;
        }
        size_t last_live = last_non_empty_block_index();  // 0 when the deque is fully empty
        if (m_blocks[last_live].values.size() < k_block_capacity) {
            target = last_live;
            return true;
        }
        if (last_live + 1 < m_blocks.size()) {
            // Blocks past the last non-empty one are always reset() with their storage intact
            // (reserve pre-provisions them; rotation and pop_back preserve them), so this push
            // cannot allocate.
            target = last_live + 1;
            return true;
        }
        if (!append_empty_block_back()) { return false; }
        target = m_blocks.size() - 1;
        return true;
    }

    bool append_empty_block_back() {
        block new_block;
        if (!new_block.values.reserve(k_block_capacity)) { return false; }
        return m_blocks.push_back(ktl::move(new_block));
    }

    // Compacting shifts blocks down and keeps the vacated tail as reserve, so the block count never
    // falls: the loop can only end by finding a non-empty block at the front. Once the deque has
    // drained there is none, and every shift would leave the front empty again -- hence the early
    // return. Blocks left empty are reused in place by the next push.
    //
    // The front block's storage is rotated to the tail rather than shifted over: a plain shift
    // would move-assign away its vector storage and leave the tail block with zero capacity, so a
    // later push into it would allocate -- breaking reserve()'s promise that pushes within
    // capacity never touch the heap, which the scheduler's interrupt path depends on.
    void remove_empty_front_blocks() {
        if (m_size == 0) { return; }
        while (m_blocks.size() > 1 && m_blocks[0].empty()) {
            block vacated = ktl::move(m_blocks[0]);
            vacated.reset();
            for (size_t i = 0; i + 1 < m_blocks.size(); ++i) { m_blocks[i] = ktl::move(m_blocks[i + 1]); }
            m_blocks[m_blocks.size() - 1] = ktl::move(vacated);
        }
    }

    size_t first_non_empty_block_index() const {
        for (size_t i = 0; i < m_blocks.size(); ++i) {
            if (!m_blocks[i].empty()) { return i; }
        }
        return 0;
    }

    size_t last_non_empty_block_index() const {
        for (size_t i = m_blocks.size(); i > 0; --i) {
            if (!m_blocks[i - 1].empty()) { return i - 1; }
        }
        return 0;
    }

    ktl::vector<block> m_blocks;
    size_t m_size = 0;
};

}  // namespace ktl
