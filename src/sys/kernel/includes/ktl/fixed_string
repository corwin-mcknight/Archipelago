#pragma once

#include <string.h>

#include <ktl/string_view>

namespace ktl {

template <size_t N> class fixed_string {
   public:
    char m_buffer[N];

    fixed_string() { memset(m_buffer, 0, N); }
    fixed_string(const char* str) {
        memset(m_buffer, 0, N);
        for (size_t i = 0; i + 1 < N && str[i]; i++) { m_buffer[i] = str[i]; }
    }

    fixed_string(const ktl::string_view str) {
        memset(m_buffer, 0, N);
        str.copy(m_buffer, N - 1);  // leave room for the terminator zeroed above
    }

    operator ktl::string_view() const { return ktl::string_view(m_buffer, length()); }


    // Bounded scan: an unterminated buffer must not be over-read.
    size_t length() const {
        size_t len = 0;
        while (len < N && m_buffer[len] != '\0') { ++len; }
        return len;
    }

    size_t size() const { return N; }

    template <typename F> void for_each(F func) const {
        size_t len = length();
        for (size_t i = 0; i < len; i++) { func(m_buffer[i]); }
    }

    const char* c_str() const { return m_buffer; }
};
};  // namespace ktl
